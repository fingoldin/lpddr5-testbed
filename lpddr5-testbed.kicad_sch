		(uuid "ca7dd573-9685-5d1c-a871-209ff29c2660")
	)
	(text "One LPDDR5 SDRAM on a DDR4 SO-DIMM card for the ZCU104 PL memory socket: channel A, byte 0, rank 0.\nCommands and writes go through resistive dividers at the card fingers; reads go straight to the FPGA, pseudo-differential against a DAC reference."
		(exclude_from_sim no)
		(at 15.24 23.5 0)
