	(fp_text user "FINGER EDGE: chamfer 0.25 mm x 45 deg MAX on each face, or none. NO 20/30/45 deg gold-finger bevel." (at 0 4.4 0) (layer "Cmts.User") (uuid "90fb16f5-f77c-5af6-a95b-9422107044d7") (effects (font (size 0.5 0.5) (thickness 0.075)) (justify left)))
