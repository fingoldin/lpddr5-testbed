## ------------------------------------------------------------------------------------------------------------
## RESET_n  (bank 66: the only output in the read bank)
## Static LVCMOS12 output, 100 ohm series + 1 k to GND on the card: 0.96 / 1.03 / 1.12 V at the ball.
## The 1 k holds the DRAM in reset while the FPGA is unconfigured.  DRIVE 8: the default 12 mA is not available
## for LVCMOS12 in an HP bank (DRC BIVB-1).
## ------------------------------------------------------------------------------------------------------------
set_property PACKAGE_PIN AP11 [get_ports {reset_n}]      ;# finger 232 (B) DQ60 | RESET_N_F -> RESET_N (U1.H1) | bank 66 T0L N5 (bitslice 5) | IO_L3N_T0L_N5_AD15N_66 | the only output in its bank
set_property IOSTANDARD LVCMOS12 [get_ports {reset_n}]
set_property DRIVE 8 [get_ports {reset_n}]

## ------------------------------------------------------------------------------------------------------------
## Other fingers the card uses; they are NOT FPGA socket pins.  Reference DAC: DAC53401, I2C address 0x48.
##   finger 253 (F) SCL    -> card net SCL   : I2C clock to the reference DAC (host 4.99 k pull-up to 3.3 V, mux 0x74 channel 7)
##   finger 254 (B) SDA    -> card net SDA   : I2C data to the reference DAC (host 4.99 k pull-up to 3.3 V)
##   finger 255 (F) VDDSPD -> card net V3P3  : VDDSPD: 3.3 V on the ZCU104 (VDD1 regulator input, LDO bias, DAC)
## On the ZCU104 the SODIMM SCL / SDA go to port 7 of the I2C1 switch TCA9548A U34 (address 0x74); that bus is
## PS I2C1 (MIO16 SCL / MIO17 SDA) and is shared with the PL pins below through a level shifter (UG1267 figure 3-12,
## table 3-16; schematic XTP484 sheet 45, nets PL_I2C1_SCL_LS / PL_I2C1_SDA_LS).  Select port 7 on the switch first,
## then talk to 0x48.
## Uncomment to reach the DAC from the PL instead of the PS (bank 87, 3.3 V, open drain, pull-ups on the board):
#set_property PACKAGE_PIN N12 [get_ports pl_i2c1_scl] ;# IO_L1N_AD11N_87, PL_I2C1_SCL_LS
#set_property PACKAGE_PIN P12 [get_ports pl_i2c1_sda] ;# IO_L1P_AD11P_87, PL_I2C1_SDA_LS
#set_property IOSTANDARD LVCMOS33 [get_ports {pl_i2c1_scl pl_i2c1_sda}]

## 85 further FPGA pins of the socket are left open on the card (list: PINMAP.md).  Leave them out of the design
## or drive them low; none is tied to a rail on the card.
