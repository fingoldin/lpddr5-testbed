## FALL-BACK receiver for the read pins: SLVS_400_18 on plain IBUFDS (no IBUFDS_DPHY), no differential termination.
## Read this file AFTER lpddr5_testbed_zcu104.xdc; it only overrides the standard of the read ports.
## With TERM_NONE the standard puts no 1.8 V requirement on the bank; with termination on, Vivado demands
## VCCO = 1.8 V, which the ZCU104 does not have on these banks.
## Window (design/netlist.json, analysis.read.slvs_400_18_window): VID 0.14 .. 0.45 V, VICM 0.07 .. 0.33 V.
set_property IOSTANDARD SLVS_400_18 [get_ports {rdq_n[*] rdq_p[*] rdqs_n rdqs_p}]
set_property DIFF_TERM_ADV TERM_NONE [get_ports {rdq_n[*] rdq_p[*] rdqs_n rdqs_p}]
