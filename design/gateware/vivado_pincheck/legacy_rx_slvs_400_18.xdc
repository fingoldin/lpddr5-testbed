## GENERATED by scripts/gen_gateware.py from design/netlist.json (revision 0.2, 2026-11-10) and
## design/gateware_deskew.json.  Do not edit: change the spec and re-run the generator.
## HISTORY / LEGALITY ONLY.  SLVS_400_18 is NOT a supported receiver of this card: the merged system simulation gives
## -13 mV of mask margin in the slow corner at the default reference (design/DESIGN.md section 16).  This file exists
## only so that the pin-check cases M2_slvs_native16 and N4_dphy_primitive_with_slvs of run_pincheck.sh, whose
## results are kept in results/ as a record of what Vivado accepts, can still be re-run.  Do not use it in a design.
## It overrides the standard of the read ports (plain IBUFDS, no differential termination); read it AFTER
## ../lpddr5_testbed_zcu104.xdc.  With TERM_NONE the standard puts no 1.8 V requirement on the bank.
set_property IOSTANDARD SLVS_400_18 [get_ports {rdq_n[*] rdq_p[*] rdqs_n rdqs_p}]
set_property DIFF_TERM_ADV TERM_NONE [get_ports {rdq_n[*] rdq_p[*] rdqs_n rdqs_p}]
