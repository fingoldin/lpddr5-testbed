## GENERATED by scripts/gen_gateware.py.  Only for the case N2b of run_pincheck.sh: lets the strobe, which is not
## on a global-clock pin, reach a BUFGCE over general routing.
create_clock -name rdqs -period 10.000 [get_ports rdqs_p]
set_property CLOCK_DEDICATED_ROUTE FALSE [get_nets -of [get_pins g_rd_strobe.u_brdqs/I]]
