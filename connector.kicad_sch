	(text "to sheet Command"
		(exclude_from_sim no)
		(at 25.4 70.08 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "71e77e2f-ae0f-502d-8ba2-7d64ed81c081")
	)
	(text "105 fingers are left open on the card: unused FPGA pins of banks 64 / 65 / 66, and the fingers\nwithout an FPGA pin (CBx, DM8, DQS8, EVENT, SAx, VPPx, VREFCA, VTT).\nGateware drives finger 75 (between the CK fingers) low."
		(exclude_from_sim no)
		(at 274.32 179.3 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "80e9c6d4-46bf-5f9a-a92b-6359e35c477e")
	)
	(text "read fingers: DQx (the net of the divider node, sheet Write) = P pin,\nVREF_Nx = N pin of the same differential input (sheet Read); RDQS_P / RDQS_N = true pair"
		(exclude_from_sim no)
		(at 25.4 194.54 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "81534458-11cf-53c1-9d52-2f2ee70d1a8d")
	)
	(text "19 VDD fingers: host 1.2 V\nVDDSPD: host 3.3 V\nSCL / SDA: host I2C (4.99 k pull-ups to 3.3 V\non the ZCU104), reference DAC at 0x48"
		(exclude_from_sim no)
		(at 111.76 105.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ce4dd38b-9359-5e46-a1e6-c06bfe02543e")
	)
	(text "to sheets Write and LPDDR5 (RESET_N_F)"
		(exclude_from_sim no)
		(at 25.4 125.96 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d3b8c665-f2d9-546b-9c03-b7528b9a5bd3")
	)
	(text "Plugs into the ZCU104 PL DDR4 socket. Pin names: DDR4 SO-DIMM signal name (FPGA ball of the XCZU7EV). Odd fingers on the front, even fingers on the back."
		(exclude_from_sim no)
		(at 15.24 21.5 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "dbf31272-fe71-5540-be25-cf690b41ec7b")
	)
